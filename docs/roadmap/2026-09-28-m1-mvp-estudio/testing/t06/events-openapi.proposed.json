    "/api/events": {
      "get": {
        "operationId": "stream_local_events",
        "summary": "Eventos locales autorizados con replay y recuperacion de estado",
        "parameters": [
          {
            "name": "X-Studio-Session-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "maxLength": 64
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}:[1-9][0-9]{0,15}$",
              "maxLength": 96
            },
            "description": "Cursor epoch:seq; seq is a positive JavaScript-safe integer. Duplicate header fields are rejected."
          },
          {
            "name": "song_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "maxLength": 26
            },
            "description": "Optional live song belonging to the session owner. Changing scope requires a reset and omitting the previous cursor."
          },
          {
            "name": "known_job_id",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "maxLength": 26
              },
              "maxItems": 64,
              "uniqueItems": true
            },
            "description": "Repeated query fields for at most 64 distinct authorized job IDs. Each must belong to the selected scope."
          }
        ],
        "responses": {
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_HOST",
                        "FORBIDDEN_ORIGIN",
                        "INVALID_PARAMS",
                        "NOT_FOUND",
                        "METHOD_NOT_ALLOWED",
                        "CONFLICT",
