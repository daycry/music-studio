{
  "components": {
    "schemas": {
      "HealthDTO": {
        "properties": {
          "process": {
            "const": "server",
            "title": "Process",
            "type": "string"
          },
          "status": {
            "const": "running",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "process"
        ],
        "title": "HealthDTO",
        "type": "object"
      },
      "SessionCredentialDTO": {
        "additionalProperties": false,
        "description": "El bootstrap autorizado exporta intencionadamente la credencial pública.",
        "properties": {
          "expires_in_s": {
            "maximum": 28800.0,
            "minimum": 1.0,
            "title": "Expires In S",
            "type": "integer"
          },
          "session_token": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Session Token",
            "type": "string"
          }
        },
        "required": [
          "session_token",
          "expires_in_s"
        ],
        "title": "SessionCredentialDTO",
        "type": "object"
      },
      "JobStateDTO": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Job Id",
            "type": "string"
          },
          "song_id": {
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Song Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "blocked",
              "running",
              "interrupted",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "attempt_id": {
            "anyOf": [
              {
                "maxLength": 26,
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "stage": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "progress": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },
          "error_code": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "required": [
          "job_id",
          "song_id",
          "status",
          "attempt_id",
          "stage",
          "progress",
          "error_code"
        ],
        "title": "JobStateDTO",
        "type": "object"
      },
      "SnapshotBeginDTO": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "snapshot",
            "title": "Status",
            "type": "string"
          },
          "phase": {
            "const": "begin",
            "title": "Phase",
            "type": "string"
          },
          "snapshot_id": {
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "reason": {
            "enum": [
              "bootstrap",
              "epoch",
              "expired",
              "ahead"
            ],
            "title": "Reason",
            "type": "string"
          },
          "active_count": {
            "maximum": 1000,
            "minimum": 0,
            "title": "Active Count",
            "type": "integer"
          },
          "known_count": {
            "maximum": 64,
            "minimum": 0,
            "title": "Known Count",
            "type": "integer"
          },
          "chunk_count": {
            "maximum": 17,
            "minimum": 0,
            "title": "Chunk Count",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "phase",
          "snapshot_id",
          "reason",
          "active_count",
          "known_count",
          "chunk_count"
        ],
        "title": "SnapshotBeginDTO",
        "type": "object"
      },
      "SnapshotChunkDTO": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "snapshot",
            "title": "Status",
            "type": "string"
          },
          "phase": {
            "const": "chunk",
            "title": "Phase",
            "type": "string"
          },
          "snapshot_id": {
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "index": {
            "maximum": 16,
            "minimum": 0,
            "title": "Index",
            "type": "integer"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobStateDTO"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "status",
          "phase",
          "snapshot_id",
          "index",
          "jobs"
        ],
        "title": "SnapshotChunkDTO",
        "type": "object"
      },
      "SnapshotEndDTO": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "snapshot",
            "title": "Status",
            "type": "string"
          },
          "phase": {
            "const": "end",
            "title": "Phase",
            "type": "string"
          },
          "snapshot_id": {
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "chunk_count": {
            "maximum": 17,
            "minimum": 0,
            "title": "Chunk Count",
            "type": "integer"
          },
          "cursor": {
            "maxLength": 96,
            "title": "Cursor",
            "type": "string"
          }
        },
        "required": [
          "status",
          "phase",
          "snapshot_id",
          "chunk_count",
          "cursor"
        ],
        "title": "SnapshotEndDTO",
        "type": "object"
      },
      "SnapshotControlDTO": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Id",
            "type": "integer"
          },
          "type": {
            "const": "system.status",
            "title": "Type",
            "type": "string"
          },
          "ts": {
            "maxLength": 24,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "title": "Ts",
            "type": "string"
          },
          "data": {
            "discriminator": {
              "mapping": {
                "begin": "#/components/schemas/SnapshotBeginDTO",
                "chunk": "#/components/schemas/SnapshotChunkDTO",
                "end": "#/components/schemas/SnapshotEndDTO"
              },
              "propertyName": "phase"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/SnapshotBeginDTO"
              },
              {
                "$ref": "#/components/schemas/SnapshotChunkDTO"
              },
              {
                "$ref": "#/components/schemas/SnapshotEndDTO"
              }
            ],
            "title": "Data"
          }
        },
        "required": [
          "id",
          "type",
          "ts",
          "data"
        ],
        "title": "SnapshotControlDTO",
        "type": "object"
      }
    }
  },
