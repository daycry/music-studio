# ADR-0005: todo dentro de la carpeta, pero solo se versionan las "recetas"
# (.python-version, uv.toml, uv.lock, pnpm-lock.yaml, models.lock.json, tools.lock.json),
# nunca los resultados.

# Python (intérprete y venv gestionados por uv, dentro de la carpeta)
.venv/
.cache/
__pycache__/
*.pyc
.pytest_cache/
pytest-cache-files-*/
.coverage*
coverage.json
coverage.xml
htmlcov/

# Serena MCP (índice local del proyecto)
.serena/

# Node
node_modules/
.next/

# Secretos (solo se versiona .env.example)
.env

# Modelos: solo se versiona el lock
models/*
!models/models.lock.json

# Herramientas descargadas: solo se versiona el lock
tools/*
!tools/tools.lock.json

# Datos generados en ejecución (ver docs/arquitectura/datos.md §2)
data/

# Evaluaciones: solo se versionan briefs/ y los resultados en markdown
# (git no reincluye ficheros dentro de un directorio excluido: por eso
# "eval/results/" se desexcluye antes de reexcluir su contenido).
eval/*
!eval/briefs/
!eval/results/
eval/results/*
!eval/results/*.md

# Ajenos al proyecto (sincronización Synology / config local del plugin Claude)
desktop.ini
.SynologyWorkingDirectory/
.claude/settings.local.json
.claude/.headroom_*
.claude/.skill-index.cache
.claude/usage-state.json
.codex/

# Editores / SO
.DS_Store
Thumbs.db

# Exportación generada para Kwipu (se reconstruye desde docs/knowledge/approved)
.claude/knowledge-services/kwipu-export/
