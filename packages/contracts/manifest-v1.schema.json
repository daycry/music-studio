{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:music-studio:manifest:v1",
  "title": "Manifiesto de procedencia v1",
  "type": "object",
  "required": [
    "manifest_version",
    "kind",
    "subject",
    "song_id",
    "created_at",
    "commercial_use",
    "provider",
    "models",
    "pipeline",
    "request",
    "inputs",
    "lineage",
    "post",
    "outputs",
    "run",
    "tools"
  ],
  "allOf": [
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "kind": {
                  "const": "cli_run"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "not": {
                    "const": "audio_take"
                  }
                },
                "subject": {
                  "properties": {
                    "type": {
                      "const": "character"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "then": {
        "properties": {
          "song_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "audio_take",
        "stems",
        "image",
        "video_clip",
        "render",
        "export",
        "lora",
        "cli_run"
      ]
    },
    "subject": {
      "$ref": "#/$defs/ref"
    },
    "song_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "commercial_use": {
      "type": "boolean"
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "local"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "name",
            "model",
            "request_id",
            "cost_eur"
          ],
          "properties": {
            "type": {
              "const": "external"
            },
            "name": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "cost_eur": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "id",
          "revision",
          "license",
          "weights"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string"
          },
          "training_data": {
            "type": "string"
          },
          "commercial_use": {
            "type": "boolean"
          },
          "weights": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hashed_file"
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "engine_id",
        "engine_version",
        "image_digest",
        "workflow_id",
        "workflow_sha256",
        "custom_nodes",
        "remote_code"
      ],
      "properties": {
        "engine_id": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remote_code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashed_file"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "task",
        "params",
        "seed"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "seed": {
          "type": "integer"
        },
        "variant_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "lyrics_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "lyrics_declaration": {
          "enum": [
            "own",
            "assistant",
            "public_domain",
            "licensed",
            null
          ]
        },
        "style_prompt": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "ref",
          "sha256",
          "rights",
          "consent"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "rights": {
            "enum": [
              "own",
              "licensed",
              "consented",
              "public_domain"
            ]
          },
          "consent": {
            "enum": [
              "self",
              "consented",
              "n_a"
            ]
          },
          "commercial_use": {
            "type": "boolean"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "parents",
        "derivation",
        "section_map"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id",
              "role"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "derivation": {
          "enum": [
            "original",
            "variant",
            "extend",
            "repaint",
            "cover",
            "complete",
            "remaster",
            "edit"
          ]
        },
        "section_map": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "post": {
      "type": "object",
      "properties": {
        "lufs_in": {
          "type": "number"
        },
        "lufs_out": {
          "type": "number"
        },
        "gain_db": {
          "type": "number"
        },
        "limiter": {
          "type": "boolean"
        },
        "true_peak_dbtp": {
          "type": "number"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "meta"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "meta": {
            "type": "object",
            "properties": {
              "sample_rate": {
                "type": "integer",
                "minimum": 1
              },
              "channels": {
                "type": "integer",
                "minimum": 1
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              },
              "lufs": {
                "type": "number"
              },
              "true_peak": {
                "type": "number"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "fps": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string"
        },
        "load_s": {
          "type": "number",
          "minimum": 0
        },
        "run_s": {
          "type": "number",
          "minimum": 0
        },
        "vram_peak_mb": {
          "type": "number",
          "minimum": 0
        },
        "vram_cap_mb": {
          "type": "number",
          "minimum": 0
        },
        "spilled": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "commercial_use": {
            "type": "boolean"
          }
        }
      }
    },
    "preparation": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "input_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sha256",
          "output_index"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "output_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "ref": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "hashed_file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
