# Copia este fichero a .env (git-ignored) y ajusta lo necesario.
# Todas las variables llevan el prefijo STUDIO_ (docs/arquitectura/convenciones.md §4).
# .env lo genera/completa `uv run scripts/init_env.py`, que crea el token del engine una sola vez.

STUDIO_DATA_DIR=./data
STUDIO_MODELS_DIR=./models

# Mapa familia=url de los engines locales (docs/arquitectura/sistema.md §1).
STUDIO_ENGINES=acestep=http://127.0.0.1:8101,analysis=http://127.0.0.1:8130,llm=http://127.0.0.1:8120,comfy=http://127.0.0.1:8110,mock=http://127.0.0.1:8199

STUDIO_VRAM_MARGIN_MB=512
STUDIO_NIGHTLY_WINDOW=01:00-07:00
STUDIO_WEB_ORIGIN=http://127.0.0.1:3000

# Secreto persistente compartido por el CLI, el server y los engines
# (cabecera X-Studio-Engine-Token). Lo genera una sola vez scripts/init_env.py;
# no lo edites a mano salvo para rotarlo.
STUDIO_ENGINE_TOKEN=

# Proveedores externos opcionales (ADR-0014): desactivados de fábrica.
# Descomenta y rellena solo si activas un proveedor concreto en /api/settings.
# STUDIO_PROVIDER_<NOMBRE>_API_KEY=
