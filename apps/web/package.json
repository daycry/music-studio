{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Estudio local: Next.js App Router con una base accesible de componentes nativos.",
  "scripts": {
    "dev": "node -e \"process.env.NEXT_TELEMETRY_DISABLED='1';process.execArgv=[];process.argv=['node','next','dev','--hostname','127.0.0.1'];import('next/dist/bin/next')\"",
    "start": "next start --hostname 0.0.0.0",
    "build": "node -e \"process.env.NEXT_TELEMETRY_DISABLED='1';process.execArgv=[];process.argv=['node','next','build','--webpack'];import('next/dist/bin/next')\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen": "openapi-typescript ../../packages/contracts/openapi.json -o lib/generated/api.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wavesurfer.js": "8.0.2"
  }
}
